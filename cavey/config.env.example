# Copy to config.env and fill in your values:
#   cp cavey/config.env.example cavey/config.env

# SSH access to all bare metal nodes
SSH_USER=ubuntu
# e.g. SSH_KEY=~/garage/edgevana.cavey
SSH_KEY=

# Where the agave repo lives on each node (quote ~ so it expands on the remote, not locally)
REMOTE_AGAVE_DIR='~/agave'

# Source for clone/build (PR #12264 / SIMD-0525)
REPO_URL=https://github.com/anza-xyz/agave.git
GIT_FETCH_REF=refs/pull/12264/head
GIT_BRANCH=simd_0525

# First IP is bootstrap; remaining are validators 2..N
# Example (Hetzner ubuntu-server-2604-lts-{1..10}):
# NODES=(
#   213.239.141.29   # lts-1 bootstrap
#   213.239.141.30   # lts-2
#   ...
# )
NODES=(

# Genesis / cluster options (match PR #12264 small-cluster testing)
SLOTS_PER_EPOCH=1024
CLUSTER_TYPE=testnet
STAKE_LAMPORTS=100000000000

# bench-tps
BENCH_TPS_TX_COUNT=2500
BENCH_TPS_DURATION=86400

# SIMD-0525 feature authority keypairs (generate with: solana-keygen new -o cavey/keys/feature-350ms.json)
# Their pubkeys are patched into feature-set on each node during build/genesis.
FEATURE_KEY_350MS=
FEATURE_KEY_300MS=
FEATURE_KEY_250MS=
FEATURE_KEY_200MS=

# Storage: auto-place ledger/accounts/snapshots on NVMe (default). Override per path:
# STORAGE_LEDGER=
# STORAGE_ACCOUNTS=
# STORAGE_SNAPSHOTS=
